# never commit a real foobar2000 profile. dist-config\ holds the small, audited
# configuration harvested from a clean-room install; a live profile would carry
# the media library, playlists, scrobbler credentials and absolute paths.
profile/
otoha-backup/
config.sqlite
metadb.sqlite
!dist-config/config.sqlite

# scratch space
scratch/
tmp/
